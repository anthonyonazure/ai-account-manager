# Anthropic — optional. With the key, briefings are LLM-generated.
# Without it, AAM falls back to a deterministic stub so the demo runs cold.
ANTHROPIC_API_KEY=
AAM_MODEL=claude-sonnet-4-6

# Database (SQLite by default; swap for postgresql+asyncpg://... in prod)
AAM_DATABASE_URL=sqlite+aiosqlite:///./aam.db

# Toolkit settings (mocks by default — see ../b2b-agent-toolkit/.env.example)
B2B_USE_MOCKS=true
B2B_PORTAL_BASE_URL=http://localhost:8001

# Optional Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional Slack delivery — sends each AM's briefing as a DM
# Bot scopes required: chat:write, users:read, users:read.email, im:write
AAM_SLACK_BOT_TOKEN=
# Default Slack handle (or U-id, or email) when no per-AM mapping is set
AAM_SLACK_RECIPIENT_DEFAULT=
# Per-AM overrides (uppercase email localpart, dots → underscores):
# AAM_SLACK_RECIPIENT_ALICE=alice
# AAM_SLACK_RECIPIENT_BOB=bob
# AAM_SLACK_RECIPIENT_CARMEN=U02EXAMPLE

# Optional Microsoft Teams delivery (Path A — Power Automate channel webhook)
# Setup: in Teams pick a channel → ⋯ → Workflows → "Send webhook alerts to a
# channel" template → copy the generated URL.
AAM_TEAMS_WEBHOOK_URL=

# Optional Microsoft Teams personal DMs (Path B — Bot Framework)
# Setup: see teams-app/README.md (Azure Bot Service + Teams app manifest)
AAM_TEAMS_BOT_APP_ID=
AAM_TEAMS_BOT_APP_PASSWORD=
# Required for SingleTenant bots; optional for MultiTenant. Defaults to B2B_M365_TENANT_ID.
AAM_TEAMS_BOT_TENANT_ID=
# JSON map: AAD object id → AM email. Replace with a real directory lookup in prod.
# AAM_AM_DIRECTORY={"aad-guid-of-alice":"alice@cyberco.com"}
